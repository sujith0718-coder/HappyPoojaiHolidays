<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>The Little Festival Universe</title>
<style>
:root{--sky:#14123a;--sky2:#2a1f5c;--gold:#ffc54a;--mar:#ff8a1f;--cream:#fff4dc;--red:#c8442b;--em:#2f8f6b;--ink:#fff4dc;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
