<script>
const $=s=>document.querySelector(s),RM=matchMedia('(prefers-reduced-motion:reduce)').matches;
const ld=(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k));return v&&typeof v==='object'?{...d,...v}:d}catch(e){return d}};
let S=ld('fu',{joys:[],quests:[],found:[],jar:[],seen:[],moon:0,vol:.5,sfx:true,amb:false,auto:true,mute:false,tr:0});
['joys','quests','found','jar','seen'].forEach(k=>{if(!Array.isArray(S[k]))S[k]=[]});S.vol=Math.min(1,Math.max(0,+S.vol||.5));S.tr=+S.tr>=0&&+S.tr<5?+S.tr:0;
const save=()=>{try{localStorage.setItem('fu',JSON.stringify(S))}catch(e){}};
const toast=t=>{const e=$('#toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',2600)};
/* ---------- audio ---------- */
let ctx,mg,sg,an,tm=null,playing=false,t0=0,played=0,ambN;
const T=[{n:'🪔 Festival Glow',m:'Warm Indian-scale instrumental',r:146.8,sc:[0,1,4,5,7,8,11,12],ms:420,w:'triangle'},{n:'🌙 Peaceful Evening',m:'Soft ambient under the stars',r:130.8,sc:[0,2,4,7,9,12],ms:900,w:'sine'},{n:'🏡 Cozy Moments',m:'Gentle, comforting warmth',r:174.6,sc:[0,2,4,7,9,12,14],ms:650,w:'sine'},{n:'✨ Magical Adventure',m:'Whimsical and playful',r:196,sc:[0,2,4,7,9,12,16],ms:300,w:'square'},{n:'🎉 Celebration Mode',m:'Uplifting festive tune',r:164.8,sc:[0,2,4,5,7,9,11,12],ms:240,w:'triangle'}];
function init(){if(ctx)return true;try{ctx=new(window.AudioContext||window.webkitAudioContext)();mg=ctx.createGain();sg=ctx.createGain();an=ctx.createAnalyser();an.fftSize=64;mg.connect(an);an.connect(ctx.destination);sg.connect(ctx.destination);applyVol();return true}catch(e){toast('Audio is not available in this browser');return false}}
function applyVol(){if(!ctx)return;mg.gain.value=S.mute?0:S.vol*.5;sg.gain.value=S.mute||!S.sfx?0:.4}
function note(f,d,w,dest,v){const o=ctx.createOscillator(),g=ctx.createGain(),n=ctx.currentTime;o.type=w;o.frequency.value=f;g.gain.setValueAtTime(0,n);g.gain.linearRampToValueAtTime(v,n+.03);g.gain.exponentialRampToValueAtTime(.001,n+d);o.connect(g);g.connect(dest);o.start(n);o.stop(n+d+.1)}
function step(){const t=T[S.tr];let i=0;return()=>{if(!ctx)return;i++;const f=t.r*2**(t.sc[Math.random()*t.sc.length|0]/12);note(f,t.ms/300,t.w,mg,.25);if(i%8==1)[0,7,12].forEach(s=>note(t.r/2*2**(s/12),t.ms*8/1000,'sine',mg,.12))}}
function startM(){if(!init())return;ctx.resume();clearInterval(tm);const s=step();tm=setInterval(s,T[S.tr].ms);playing=true;t0=Date.now();played=0;ui()}
function stopM(){clearInterval(tm);tm=null;playing=false;ui()}
function setTr(i,start){S.tr=(i+5)%5;save();if(playing||start)startM();else ui()}
function sfx(k){if(!S.sfx||S.mute||!init())return;ctx.resume();const a={enter:[523,659,784],joy:[659,880],open:[587,740],quest:[523,659,784,1047],ach:[392,523,659,784,1047],card:[880,1175],egg:[1319,988,1319,1760],find:[784,988]}[k]||[660];a.forEach((f,i)=>setTimeout(()=>note(f,.5,'sine',sg,.3),i*110))}
function amb(){if(!ctx)return;if(ambN){try{ambN.stop()}catch(e){}ambN=null}if(!S.amb)return;const b=ctx.createBuffer(1,ctx.sampleRate*2,ctx.sampleRate),d=b.getChannelData(0);let l=0;for(let i=0;i<d.length;i++){l=(l+.02*(Math.random()*2-1))/1.02;d[i]=l*3}const s=ctx.createBufferSource(),g=ctx.createGain();s.buffer=b;s.loop=true;g.gain.value=S.mute?0:.15;s.connect(g);g.connect(ctx.destination);s.start();ambN=s}
function suggest(i){if(S.auto&&playing&&S.tr!==i)setTr(i)}
function ui(){$('#tname').textContent=T[S.tr].n;$('#tmood').textContent=T[S.tr].m;$('#play').textContent=playing?'⏸':'▶';$('#play').setAttribute('aria-label',playing?'Pause music':'Play music');$('#mute').textContent=S.mute?'🔇':'🔊';$('#mute').setAttribute('aria-label',S.mute?'Unmute all sound':'Mute all sound');$('#vol').value=S.vol;$('#sfx').checked=S.sfx;$('#amb').checked=S.amb;$('#auto').checked=S.auto}
$('#viz').innerHTML='<i></i>'.repeat(12);const vb=[...document.querySelectorAll('#viz i')];
setInterval(()=>{if(!playing||!an||S.mute||RM){vb.forEach(b=>b.style.height='3px');return}const a=new Uint8Array(an.frequencyBinCount);an.getByteFrequencyData(a);vb.forEach((b,i)=>b.style.height=Math.max(3,a[i]/255*30)+'px');$('#time').textContent=((s=>Math.floor(s/60)+':'+String(s%60).padStart(2,'0'))((Date.now()-t0)/1000|0))},90);
$('#pbtn').onclick=()=>{const o=$('#panel').classList.toggle('on');$('#pbtn').setAttribute('aria-expanded',o)};
$('#play').onclick=()=>playing?stopM():startM();$('#prev').onclick=()=>setTr(S.tr-1);$('#next').onclick=()=>setTr(S.tr+1);
$('#mute').onclick=()=>{S.mute=!S.mute;save();applyVol();if(ambN)amb();ui()};
$('#vol').oninput=e=>{S.vol=+e.target.value;save();applyVol()};
$('#sfx').onchange=e=>{S.sfx=e.target.checked;save();applyVol()};$('#amb').onchange=e=>{S.amb=e.target.checked;save();if(init()){ctx.resume();amb()}};$('#auto').onchange=e=>{S.auto=e.target.checked;save()};
/* ---------- fx ---------- */
const cv=$('#fx'),c=cv.getContext('2d');let P=[];const rs=()=>{cv.width=innerWidth;cv.height=innerHeight};rs();addEventListener('resize',rs);
for(let i=0;i<(innerWidth<600?30:60);i++)P.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.6+.4,s:Math.random()*.3+.05,t:'s',p:Math.random()*6});
function burst(x,y,e='🌼',n=24){if(RM)n=6;for(let i=0;i<n;i++){const a=Math.random()*6.28,v=Math.random()*5+2;P.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-3,t:'b',e,life:70})}}
(function loop(){c.clearRect(0,0,cv.width,cv.height);P=P.filter(p=>p.t==='s'||p.life>0);P.forEach(p=>{if(p.t==='s'){p.p+=.03;c.globalAlpha=.4+.5*Math.sin(p.p);c.fillStyle='#fff4dc';c.beginPath();c.arc(p.x,p.y,p.r,0,6.28);c.fill();if(!RM){p.y-=p.s;if(p.y<0)p.y=cv.height}}else{p.x+=p.vx;p.y+=p.vy;p.vy+=.15;p.life--;c.globalAlpha=p.life/70;c.font='20px serif';c.fillText(p.e,p.x,p.y)}});c.globalAlpha=1;requestAnimationFrame(loop)})();
/* ---------- content ---------- */
const JOYS=['🍛 The first festive meal at home','👕 Wearing something you really like','🏠 Helping decorate the house','🔔 Hearing familiar festival sounds','😂 Laughing with cousins','🛌 A break without feeling guilty'];
const COLL=[['🎒 "Bro, did you complete the record?"','😅 Surprise lab submissions','☕ Canteen conversations that last an hour','🚶 Walking between blocks, debating nothing','📚 "We\'ll study" → somehow laughing instead','🗣 Group discussions that drift off-topic']];
const HOME=['💬 Talking with family','🥘 Helping with preparations','🍽 Eating together','📞 Calling someone you miss','🌙 A quiet evening without checking the clock'];
const MOODS={'🛌 Professional Napper':['THE PROFESSIONAL NAPPER 🛌','Your mission: master the art of the horizontal afternoon.','Special ability: sleeping through any alarm, guilt-free.','Try: a blanket, a fan and zero plans.','🌙'],'🍛 Festival Food Explorer':['THE FESTIVAL FOOD EXPLORER 🍛','Your mission: visit the kitchen, discover every festive snack, and somehow return for another round.','Special ability: detecting sweets from another room.','Try: ask which dish has a secret recipe.','🍛'],'📸 Memory Collector':['THE MEMORY COLLECTOR 📸','Your mission: capture small moments, not just big ones.','Special ability: spotting golden-hour light anywhere.','Try: one photo of something ordinary but lovely.','📸'],'🎮 Offline-to-Online Gamer':['THE OFFLINE-TO-ONLINE GAMER 🎮','Your mission: play one round with family before going online.','Special ability: winning carrom against grandparents (rarely).','Try: a board game night.','🎮'],'🏡 Family Time Specialist':['THE FAMILY TIME SPECIALIST 🏡','Your mission: be fully present at the table.','Special ability: hearing every story twice and loving it.','Try: ask for a childhood story.','🏡'],'🌌 Peaceful Main Character':['THE PEACEFUL MAIN CHARACTER 🌌','Your mission: walk slowly, look up, breathe.','Special ability: making silence feel cinematic.','Try: ten minutes under the evening sky.','🌌'],'🧭 Spontaneous Explorer':['THE SPONTANEOUS EXPLORER 🧭','Your mission: say yes to one small unplanned outing.','Special ability: finding the best tea stall in any town.','Try: take a new road home.','🧭']};
const QUESTS=['🪔 Help with one festival preparation','📵 Eat one meal with family without scrolling','📞 Call an old friend','📷 Capture one beautiful holiday moment','🍬 Enjoy your favourite festive food','🧘 Take a proper break from academic pressure','🛋 Spend ten minutes doing absolutely nothing productive'];
const SURP=['😂 Joke: Why did the student bring a ladder to class? To reach higher marks.','🪔 Thought: a small light still pushes back a whole dark room.','🎒 College moment: the best plans are made in the canteen 5 minutes before the bell.','✨ Challenge: tell someone a favourite memory of them.','🍛 Challenge: try a dish you usually skip.','🌙 Thought: rest is part of the work, not the opposite.','📖 College moment: "Just 5 minutes" has never once been 5 minutes.'];
const WISH={Funny:['May your holidays have more sweets than assignments and more naps than deadlines. 🍬','May the record work wait while the festival food does not. 🍛'],Wholesome:['May your home glow with warm lights and the people who make life special. 🪔','May every meal feel like a little celebration. ✨'],Peaceful:['May you find quiet evenings, soft lights and nowhere to be. 🌙','May the world slow down just for you. 🪷'],Friendship:['Thinking of my college crew — can\'t wait to laugh again after the break! 🎒','Here\'s to canteen chats and friends who feel like family. 💛']};
const colls=()=>S.found.length+S.joys.length+S.quests.length;
const OBJ=[['🪔',22,66,'Diya','joys'],['🎒',48,82,'Backpack','college'],['🏠',70,70,'Home','home'],['🎵',12,38,'Lantern','mood'],['📖',35,50,'Book','quest'],['🌸',60,45,'Flower','card'],['🌙',78,18,'Moon','moon'],['✦',92,90,'','star']];
OBJ.forEach(([e,x,y,l,k])=>{const b=document.createElement('button');b.className='obj';b.style.left=x+'%';b.style.top=y+'%';b.setAttribute('aria-label',l||'A mysterious glowing star');b.innerHTML=e+(l?'<span>'+l+'</span>':'');b.style.fontSize=k==='star'?'20px':'';if(k==='star'){b.style.opacity='.45';b.style.minWidth='44px';b.style.minHeight='44px'}b.onclick=ev=>{burst(ev.clientX||innerWidth/2,ev.clientY||innerHeight/2,e==='🪔'?'🔥':'✨',12);open(k)};$('#world').appendChild(b)});
const NAV=[['Explore','explore'],['Memories','mem'],['Mood','mood'],['Quest','quest'],['Postcard','card']];
$('#nav').innerHTML=NAV.map(n=>`<button data-k="${n[1]}">${n[0]}</button>`).join('');$('#nav').onclick=e=>{const k=e.target.dataset.k;if(k)open(k)};
