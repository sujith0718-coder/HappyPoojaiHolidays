#card h2{background:linear-gradient(90deg,#ffc54a,#fff,#ff8a1f,#ffc54a);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:sh 6s linear infinite}
.cta{position:relative;isolation:isolate}.cta::before{content:'';position:absolute;inset:-3px;border-radius:44px;background:conic-gradient(from var(--a),transparent 60%,#fff);z-index:-1;animation:spin 2.5s linear infinite}
