.tile{position:relative;overflow:hidden}.tile::before{content:'';position:absolute;inset:0;background:radial-gradient(160px circle at var(--mx,50%) var(--my,50%),#ffc54a40,transparent 60%);opacity:0;transition:opacity .3s;pointer-events:none}.tile:hover::before{opacity:1}
#scene{transform-origin:50% 65%}#world.on #scene{animation:cam 7s cubic-bezier(.16,.8,.2,1)}
@keyframes cam{from{transform:scale(1.7) translateY(8%);filter:brightness(.4)}to{transform:none;filter:none}}
#world.on .obj{animation:bob 3.5s ease-in-out infinite,pk .9s backwards cubic-bezier(.2,.9,.3,1.3)}@keyframes pk{from{opacity:0;scale:.2}}
