@property --a{syntax:'<angle>';initial-value:0deg;inherits:false}
#bg::before{content:'';position:absolute;inset:-25%;background:radial-gradient(40% 30% at 30% 30%,#ff8a1f66,transparent),radial-gradient(35% 30% at 72% 38%,#7a4bff55,transparent),radial-gradient(40% 30% at 50% 75%,#2f8f6b55,transparent);filter:blur(46px);animation:aur 16s ease-in-out infinite alternate}
@keyframes aur{to{transform:translate(7%,-5%) rotate(9deg) scale(1.2)}}
